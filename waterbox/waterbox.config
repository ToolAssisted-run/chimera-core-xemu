  "settings": [
    {
      "name": "port1",
      "display": "Controller in Port 1",
      "type": "enum",
      "options": [
        "none",
        "duke"
      ],
      "default": "duke",
      "description": "What is plugged into controller port 1. 'duke' is the launch pad this core emulates. An empty port has no USB hub and no device - games enumerate exactly what a real console with that port empty would find - and its buttons and sticks leave the input roll entirely, because a control the machine does not have is not a column and not a character in a movie."
    },
    {
      "name": "port2",
      "display": "Controller in Port 2",
      "type": "enum",
      "options": [
        "none",
        "duke"
      ],
      "default": "none",
      "description": "What is plugged into controller port 2. 'duke' is the launch pad this core emulates. An empty port has no USB hub and no device - games enumerate exactly what a real console with that port empty would find - and its buttons and sticks leave the input roll entirely, because a control the machine does not have is not a column and not a character in a movie."
    },
    {
      "name": "port3",
      "display": "Controller in Port 3",
      "type": "enum",
      "options": [
        "none",
        "duke"
      ],
      "default": "none",
      "description": "What is plugged into controller port 3. 'duke' is the launch pad this core emulates. An empty port has no USB hub and no device - games enumerate exactly what a real console with that port empty would find - and its buttons and sticks leave the input roll entirely, because a control the machine does not have is not a column and not a character in a movie."
    },
    {
      "name": "port4",
      "display": "Controller in Port 4",
      "type": "enum",
      "options": [
        "none",
        "duke"
      ],
      "default": "none",
      "description": "What is plugged into controller port 4. 'duke' is the launch pad this core emulates. An empty port has no USB hub and no device - games enumerate exactly what a real console with that port empty would find - and its buttons and sticks leave the input roll entirely, because a control the machine does not have is not a column and not a character in a movie."
    },
    {
      "name": "renderer",
      "display": "Renderer",
      "type": "enum",
      "options": [
        "opengl-hw"
      ],
      "default": "opengl-hw",
      "description": "Which renderer draws the picture - and an Xbox has exactly one: xemu's own OpenGL renderer, its calls leaving the sandbox to your machine's GPU. On an Xbox the GPU's output feeds back into the machine's own RAM, so a different driver is a different machine, and a movie recorded here replays only on the same driver. The gate's internal 'null' renderer (no picture, fully deterministic) still exists for the harness but is not a way to play, so it is not offered."
    },
    {
      "name": "memLimit128",
      "display": "128MB RAM (debug console)",
      "type": "bool",
      "default": false,
      "description": "A retail Xbox has 64MB of RAM; development consoles had 128MB, and a few homebrew titles use it. The machine's RAM size is part of the machine: two projects that differ here do not share movies."
    }
  ],
  "firmware": [
    {
      "id": "mcpx",
      "display": "MCPX Boot ROM",
      "description": "The 512-byte secret boot ROM inside the MCPX southbridge (the canonical dump is mcpx_1.0.bin). The very first code the machine runs; nothing boots without it.",
      "size": 512,
      "name": "mcpx_1.0.bin"
    },
    {
      "id": "bios",
      "display": "Flash ROM (BIOS)",
      "description": "The machine's 1MB flash image holding the second bootloader and the kernel - a retail dump, or a homebrew BIOS such as Cerbios or a Complex/EvoX image. 256KB and 512KB images are also accepted (the frontend will call them custom).",
      "size": 1048576,
      "name": "complex_4627.bin"
    },
    {
      "id": "hdd",
      "display": "Hard Disk Image",
      "description": "The Xbox's hard disk as a qcow2 or raw image, holding the dashboard and save partitions. It is NEVER written: all writes land in an in-memory overlay inside the sandbox, so the file on disk stays pristine and every run starts from the same disk.",
      "name": "xbox_hdd.qcow2"
    },
    {
      "id": "eeprom",
      "display": "EEPROM",
      "required": false,
      "description": "The console's 256-byte identity: serial number, MAC address, region and per-console crypto keys. OPTIONAL: without one the core uses a frozen built-in identity, the same for everyone, which is what movies want. Supply your own console's dump only if a game must see that specific console.",
      "size": 256,
      "name": "eeprom.bin"
    }
  ]
}
