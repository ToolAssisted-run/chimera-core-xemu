  "settings": [
    {
      "name": "cpuSpeed",
      "display": "setting.cpuspeed",
      "type": "enum",
      "options": [
        "500",
        "1000",
        "250",
        "125"
      ],
      "default": "500",
      "description": "setting.cpuspeed.about"
    },
    {
      "name": "port1",
      "display": "setting.port1",
      "type": "enum",
      "options": [
        "none",
        "duke"
      ],
      "default": "duke",
      "description": "setting.port1.about"
    },
    {
      "name": "port2",
      "display": "setting.port2",
      "type": "enum",
      "options": [
