  "settings": [
    {
      "name": "cpuSpeed",
      "display": "CPU speed",
      "type": "enum",
      "options": [
        "500",
        "1000",
        "250",
        "125"
      ],
      "default": "500",
      "description": "How many million instructions the Xbox's processor runs in one second of the console's time. This decides how much work fits in a frame, so it is part of the machine and not just a speed control. Clock speed and instructions are two different things. The processor is a Pentium III clocked at 733 MHz, and a game reads that clock at its exact rate (733.33 million ticks a second) whatever this setting is. A Pentium III finishes fewer than one instruction per clock tick on average, so a real Xbox runs roughly 440 to 590 million instructions a second; 500 is inside that range, and so is the closest to a real console. The emulator can only charge a power-of-two time for each instruction, so the values in between cannot be offered: 1000 would be a processor faster than the real one, and 250 and 125 slower ones, on which games drop frames where the real console did not (they are for when emulation speed matters more). Standalone xemu has no such number: it runs instructions as fast as your computer can. A movie recorded at one value does not play back at another."
    },
    {
      "name": "port1",
      "display": "Controller in Port 1",
      "type": "enum",
      "options": [
        "none",
        "duke"
      ],
      "default": "duke",
      "description": "What is plugged into controller port 1. 'duke' is the original Xbox controller, the one this core emulates. With the port empty, games find nothing connected there, as on a real console. The port's buttons and sticks are then also removed from the input columns and from the movie."
    },
    {
      "name": "port2",
      "display": "Controller in Port 2",
      "type": "enum",
      "options": [
        "none",
        "duke"
      ],
      "default": "none",
      "description": "What is plugged into controller port 2. 'duke' is the original Xbox controller, the one this core emulates. With the port empty, games find nothing connected there, as on a real console. The port's buttons and sticks are then also removed from the input columns and from the movie."
    },
    {
      "name": "port3",
      "display": "Controller in Port 3",
      "type": "enum",
      "options": [
        "none",
        "duke"
      ],
      "default": "none",
      "description": "What is plugged into controller port 3. 'duke' is the original Xbox controller, the one this core emulates. With the port empty, games find nothing connected there, as on a real console. The port's buttons and sticks are then also removed from the input columns and from the movie."
    },
    {
      "name": "port4",
      "display": "Controller in Port 4",
      "type": "enum",
      "options": [
        "none",
        "duke"
      ],
      "default": "none",
      "description": "What is plugged into controller port 4. 'duke' is the original Xbox controller, the one this core emulates. With the port empty, games find nothing connected there, as on a real console. The port's buttons and sticks are then also removed from the input columns and from the movie."
    },
    {
      "name": "renderer",
      "display": "Renderer",
      "type": "enum",
      "options": [
        "opengl-hw",
        "vulkan-hw"
      ],
      "default": "opengl-hw",
      "description": "Which renderer draws the picture. Both draw on your computer's graphics card, outside the sandbox. 'opengl-hw' is xemu's OpenGL renderer and the default. 'vulkan-hw' is xemu's Vulkan renderer. It needs a graphics driver that has Vulkan and a Chimera that hands Vulkan to cores (Development build 4ca6e302 or later); without either the project does not start and says why.\n\nThe renderer is part of the machine. On an Xbox, what the graphics chip draws goes back into the console's own memory, and the two renderers do not round every pixel alike. A different renderer, or a different graphics driver, can therefore give a slightly different machine: a movie recorded with one plays back only with the same one. Choose the renderer when you create the project. A renderer that draws nothing exists for the core's own tests. It is not for playing and is not offered."
    },
    {
      "name": "internalResolution",
      "display": "Internal Resolution",
      "type": "enum",
      "options": [
        "1x",
        "2x",
        "3x"
      ],
      "default": "1x",
      "description": "How large the graphics card draws everything (xemu's surface scale). The Xbox usually draws at 640x480. '2x' and '3x' draw the same frame at 1280x960 and 1920x1440, so edges are smoother and a recording has real detail. It costs graphics time and makes the picture larger. THIS SETTING AFFECTS SYNC. Everything the graphics chip draws is written into the console's memory, and a larger picture is reduced on the way by keeping only every second or third pixel. That is not what a 1x picture would have put there. Measured on Prince of Persia over 600 frames, 2x differs from 1x in 1.5 million bytes of memory, while two 1x runs are identical. A game that reads its own picture reads different bytes. So this is part of the machine. The project and the movie record it, and a movie recorded at one value needs the same value to play back. Choose it when the project is created and do not change it afterwards."
    },
    {
      "name": "idleSkip",
      "display": "Halt the kernel's idle loop",
      "type": "bool",
      "default": true,
      "description": "The Xbox system software never stops the processor. When a game has nothing to do, it runs a small waiting loop until the next interrupt, and emulating that loop is expensive (96 percent of a frame in Prince of Persia's menus). With this on, the loop is replaced by an instruction that makes the processor sleep until the next interrupt. The console's clock reads the same and the game runs the same, and idle time costs almost nothing. It is part of the machine, so a movie recorded with it on plays back only with it on."
    },
    {
      "name": "memLimit128",
      "display": "128MB RAM (debug console)",
      "type": "bool",
      "default": false,
      "description": "A retail Xbox has 64 MB of memory. Development consoles had 128 MB, and a few homebrew programs use it. The amount of memory is part of the machine, so two projects that differ here cannot share movies."
    }
  ],
  "firmware": [
    {
      "id": "mcpx",
      "display": "MCPX Boot ROM",
      "description": "The 512-byte boot ROM hidden inside the Xbox's MCPX chip. The usual dump is named mcpx_1.0.bin. It is the first code the machine runs, and nothing starts without it.",
      "size": 512,
      "name": "mcpx_1.0.bin"
    },
    {
      "id": "bios",
      "display": "Flash ROM (BIOS)",
      "description": "The machine's 1 MB flash memory image. It holds the second boot stage and the system kernel. It can be a retail dump or a homebrew BIOS such as Cerbios, Complex or EvoX. Images of 256 KB and 512 KB are also accepted, and Chimera then calls them custom.",
      "size": 1048576,
      "name": "complex_4627.bin"
    },
    {
      "id": "hdd",
      "display": "Hard Disk Image",
      "description": "The Xbox's hard disk as a qcow2 or raw image. It holds the dashboard and the save partitions. The file is NEVER written. Everything the console writes is kept in memory inside the sandbox, so the file stays as it is and every run starts from the same disk.",
      "name": "xbox_hdd.qcow2"
    },
    {
      "id": "eeprom",
      "display": "EEPROM",
      "required": false,
      "description": "The console's 256 bytes of identity data: serial number, network address, region and encryption keys. It is OPTIONAL. Without a file the core uses a fixed built-in identity that is the same for everyone, which is what movies need. Supply your own console's dump only if a game must see that particular console.",
      "size": 256,
      "name": "eeprom.bin"
    }
  ]
}
