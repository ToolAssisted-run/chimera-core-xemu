      "options": [
        "1x",
        "2x",
        "3x"
      ],
      "default": "1x",
      "description": "setting.internalresolution.about"
    },
    {
      "name": "idleSkip",
      "display": "setting.idleskip",
      "type": "bool",
      "default": true,
      "description": "setting.idleskip.about"
    },
    {
      "name": "memLimit128",
