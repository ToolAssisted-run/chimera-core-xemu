pgraph: the shader caches hand out entries lazily, so a savestate does not carry 287 MB of links

The GL renderer's shader binding cache is fifty thousand entries of 4.9 KB
(250 MB) and the shader module cache another fifty thousand, and lru_add_free
was called on every entry at init - a link written into each, one touch per
page. The renderer comes up after the machine is sealed, so every one of those
pages was dirty from then on and every savestate carried them: 287 MB holding
sixteen useful bytes a page, measured on Prince of Persia, where the machine's
own memory in use was 37 MB. Lru gains a pool - the untouched tail of the
array - from which an entry is taken only when no evicted one is free, and is
linked in then; the two caches use it. Which array slot a new entry lands in
changes; nothing the renderer produces does, and the choice depends only on
the guest's sequence, so native and sandbox agree.

diff --git a/hw/xbox/nv2a/pgraph/gl/shaders.c b/hw/xbox/nv2a/pgraph/gl/shaders.c
index 2966710..4f93de6 100644
--- a/hw/xbox/nv2a/pgraph/gl/shaders.c
+++ b/hw/xbox/nv2a/pgraph/gl/shaders.c
@@ -572,9 +572,9 @@ void pgraph_gl_init_shaders(PGRAPHState *pg)
     lru_init(&r->shader_cache);
     r->shader_cache_entries = malloc(shader_cache_size * sizeof(ShaderBinding));
     assert(r->shader_cache_entries != NULL);
-    for (int i = 0; i < shader_cache_size; i++) {
-        lru_add_free(&r->shader_cache, &r->shader_cache_entries[i].node);
-    }
+    /* CHIMERA: a pool, not a loop - see Lru.pool */
+    lru_add_free_pool(&r->shader_cache, r->shader_cache_entries,
+                      sizeof(ShaderBinding), shader_cache_size);
 
     r->shader_cache.init_node = shader_cache_entry_init;
     r->shader_cache.compare_nodes = shader_cache_entry_compare;
@@ -593,9 +593,8 @@ void pgraph_gl_init_shaders(PGRAPHState *pg)
     r->shader_module_cache_entries =
         g_malloc_n(shader_module_cache_size, sizeof(ShaderModuleCacheEntry));
     assert(r->shader_module_cache_entries != NULL);
-    for (int i = 0; i < shader_module_cache_size; i++) {
-        lru_add_free(&r->shader_module_cache, &r->shader_module_cache_entries[i].node);
-    }
+    lru_add_free_pool(&r->shader_module_cache, r->shader_module_cache_entries,
+                      sizeof(ShaderModuleCacheEntry), shader_module_cache_size);
 
     r->shader_module_cache.init_node = shader_module_cache_entry_init;
     r->shader_module_cache.compare_nodes = shader_module_cache_entry_compare;
diff --git a/include/qemu/lru.h b/include/qemu/lru.h
index 91abb31..a20fa29 100644
--- a/include/qemu/lru.h
+++ b/include/qemu/lru.h
@@ -45,6 +45,16 @@ struct Lru {
 	int num_used;
 	int num_free;
 
+	/* CHIMERA: entries never handed out yet. lru_add_free wrote a link into
+	 * every entry of an array at init - fifty thousand shader bindings of
+	 * 4.9 KB each is 250 MB of pages touched once to hold sixteen bytes, and
+	 * a sandbox savestate carries every page ever written. A pool is the
+	 * array's untouched tail: entries come out of it only when no evicted
+	 * one is free, and are linked in then. */
+	uint8_t *pool;
+	size_t pool_stride;
+	size_t pool_left;
+
 	/* Initialize a node. */
 	void (*init_node)(Lru *lru, LruNode *node, const void *key);
 
@@ -71,6 +81,9 @@ void lru_init(Lru *lru)
 	lru->post_node_evict = NULL;
 	lru->num_free = 0;
 	lru->num_used = 0;
+	lru->pool = NULL;
+	lru->pool_stride = 0;
+	lru->pool_left = 0;
 }
 
 static inline
@@ -81,6 +94,17 @@ void lru_add_free(Lru *lru, LruNode *node)
 	lru->num_free += 1;
 }
 
+/* CHIMERA: `count` entries of `stride` bytes at `base`, none of them touched
+ * until it is needed (see Lru.pool). The node must be the first member. */
+static inline
+void lru_add_free_pool(Lru *lru, void *base, size_t stride, size_t count)
+{
+	lru->pool = (uint8_t *)base;
+	lru->pool_stride = stride;
+	lru->pool_left = count;
+	lru->num_free += count;
+}
+
 static inline
 unsigned int lru_hash_to_bin(Lru *lru, uint64_t hash)
 {
@@ -147,12 +171,24 @@ LruNode *lru_get_one_free(Lru *lru)
 {
 	LruNode *found;
 
-	QTAILQ_FOREACH_REVERSE(found, &lru->global, next_global) {
-		if (!lru_is_node_in_use(lru, found)) {
-			return found;
+	/* an evicted entry first: its page is written already */
+	if ((size_t)lru->num_free > lru->pool_left) {
+		QTAILQ_FOREACH_REVERSE(found, &lru->global, next_global) {
+			if (!lru_is_node_in_use(lru, found)) {
+				return found;
+			}
 		}
 	}
 
+	if (lru->pool_left) {
+		found = (LruNode *)lru->pool;
+		lru->pool += lru->pool_stride;
+		lru->pool_left -= 1;
+		lru->num_free -= 1;   /* lru_add_free counts it again */
+		lru_add_free(lru, found);
+		return found;
+	}
+
 	return lru_evict_one(lru);
 }
 
