diff --git a/hw/xbox/smbus_storage.c b/hw/xbox/smbus_storage.c
index e2e0497b26..ccd8690307 100644
--- a/hw/xbox/smbus_storage.c
+++ b/hw/xbox/smbus_storage.c
@@ -53,6 +53,10 @@ typedef struct SMBusStorageDevice {
     bool persist;
 } SMBusStorageDevice;
 
+/* CHIMERA: the frozen identity a machine falls back to when no EEPROM file
+ * is supplied (see waterbox/default-eeprom.c) */
+extern const uint8_t chimera_default_eeprom[256];
+
 static void smbus_storage_realize(DeviceState *dev, Error **errp)
 {
     SMBusStorageDevice *s = SMBUS_STORAGE(dev);
@@ -63,6 +67,15 @@ static void smbus_storage_realize(DeviceState *dev, Error **errp)
     if (s->file) {
         int size = get_image_size(s->file, NULL);
         if (size != s->size) {
+            /* CHIMERA: no file (or a wrong one) means the frozen default
+             * identity, not a dead machine - a sandbox cannot mint one to
+             * disk the way the desktop build does */
+            if (s->size == (int)sizeof(chimera_default_eeprom)) {
+                fprintf(stderr, "smbus-storage: '%s' unusable; using the "
+                        "built-in default EEPROM\n", s->file);
+                memcpy(s->data, chimera_default_eeprom, s->size);
+                return;
+            }
             error_setg(errp, "%s: file '%s' size of %d, expected %d\n",
                 __func__, s->file, size, s->size);
             return;
