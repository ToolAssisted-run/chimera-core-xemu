@@ -24,6 +24,10 @@
 #include "debug.h"
 #include "renderer.h"
 
+/* the bridge's context id (chimera-gl); the binding reset next to it comes in
+ * with gloffscreen.h, which renderer.h already includes */
+uint64_t chimera_gl_context_id(void);
+
 GloContext *g_nv2a_context_render;
 GloContext *g_nv2a_context_display;
 
@@ -99,6 +103,97 @@
     pg->gl_renderer_state = NULL;
 }
 
+/* Which real GL context the objects below were built in. A chimera savestate
+ * restores the whole guest, this static included, so after a load it holds the
+ * id from the machine that was saved; the live id is this session's. They
+ * differ exactly when the objects' names are gone. (0 = cannot tell.) */
+static uint64_t s_chimera_gl_context;
+
+/* ZERO MEANT TWO THINGS, AND ONE OF THEM WAS A LIE (chimera issue 126).
+ *
+ * The static above starts at 0 and is first written by the check below, which
+ * runs at the head of a path that is about to draw - so never during Init. But
+ * pgraph_gl_init HAS run by the end of Init, at nv2a_realize, and hands out
+ * real GL names there. So there is one state in every session that carries 0
+ * while the objects already exist: the greenzone's frame-0 anchor, taken right
+ * after Init and before the first frame advance. Loading it used to read that 0
+ * as "this machine has never held any GL objects, nothing to rebuild", when
+ * what it really means is "this state was taken before the renderer looked, so
+ * it cannot vouch for the objects the driver is holding NOW" - and those are
+ * whatever the frames after the anchor left behind: surfaces deleted and handed
+ * out again, textures resized, framebuffers reattached.
+ *
+ * Reported on PCSX2 and Maximo: Ghosts to Glory as a corrupt picture when a
+ * movie is played from frame 0 or frame 1 and a clean one from frame 2 - which
+ * is exactly where TAStudio stops reaching for the anchor, since it loads the
+ * state BEFORE the frame it is going to. The same code was in every bridged
+ * core.
+ *
+ * So the host's word for it is kept instead of being guessed from the number:
+ * the engine tells every core when the machine's memory has been replaced (the
+ * StateLoaded export, which this core already implements for the translated-code
+ * cache), and after one of those the stored 0 cannot be trusted. Recording the
+ * id during Init instead would put it in the SEALED baseline, where no state
+ * carries it as a delta, and the cross-session rebuild this function exists for
+ * would stop happening; a non-zero "never seen" sentinel fails identically,
+ * because the anchor carries whatever the static's initial value is. */
+static bool s_chimera_gl_state_loaded;
+
+void pgraph_gl_state_loaded(void)
+{
+    s_chimera_gl_state_loaded = true;
+}
+
+/* Has the ground moved under the GL objects? Every name this renderer holds
+ * was handed out by one context and lives in emulated memory, so a savestate
+ * carries the names into a session where that context is gone; the driver
+ * refuses every call that names one and the guest is never told (the bridge
+ * answers the guest, not the driver). So compare the context the objects came
+ * from with the one the calls are landing on, and when it has changed, build
+ * them again from emulated memory - which is where they came from the first
+ * time. Called at the head of every path that is about to use a GL object.
+ *
+ * Cheap for that: one bridge call and an integer compare, next to a frame of
+ * drawing. */
+void pgraph_gl_check_context(NV2AState *d)
+{
+    /* taken and cleared whatever the ids say: it has been read into this
+     * decision, and a flag left standing would rebuild at some later id change
+     * for a load that is long past */
+    const bool after_load = s_chimera_gl_state_loaded;
+    s_chimera_gl_state_loaded = false;
+
+    const uint64_t live = chimera_gl_context_id();
+    if (live == 0 || live == s_chimera_gl_context) {
+        if (live != 0) {
+            s_chimera_gl_context = live;
+        }
+        return;
+    }
+
+    if ((s_chimera_gl_context != 0 || after_load) &&
+        d->pgraph.gl_renderer_state != NULL) {
+        fprintf(stderr, "chimera: GL objects came from context %llu, now %llu; "
+            "rebuilding\n", (unsigned long long)s_chimera_gl_context,
+            (unsigned long long)live);
+        /* the virtual contexts remember bindings that name gone objects; forget
+         * them before any bind, then tear the objects down and build again */
+        chimera_glo_reset_bindings();
+        pgraph_gl_finalize(d);
+        /* Deleting names the gone context handed out leaves errors queued, and
+         * the init below asserts a clean slate (pgraph_gl_init_buffers). They
+         * are the errors of a context that no longer exists; drain them. */
+        while (glGetError() != GL_NO_ERROR) { /* discard */ }
+        pgraph_gl_init(d, &error_abort);
+        /* nothing in the caches survived, so the next draw re-fetches its
+         * textures, shaders and surfaces from VRAM rather than reaching for a
+         * handle the driver no longer knows */
+        pgraph_gl_mark_textures_possibly_dirty(d, 0, memory_region_size(d->vram));
+        pgraph_gl_update_entire_memory_buffer(d);
+    }
+    s_chimera_gl_context = live;
+}
+
 static void pgraph_gl_flip_stall(NV2AState *d)
 {
     NV2A_GL_DFRAME_TERMINATOR();
