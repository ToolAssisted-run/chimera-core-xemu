 };
 
+#if defined(XBOX)
+static int timers_pre_save(void *opaque)
+{
+    /* CHIMERA: these two offsets are deltas against the HOST clock, the one
+     * thing two identical runs never share. On the Xbox machine nothing
+     * consumes them - cpu_get_tsc derives the TSC from the virtual clock -
+     * so under icount they are pure noise in an otherwise deterministic
+     * state stream. Canonicalise them so the stream is comparable.
+     */
+    TimersState *t = opaque;
+    if (icount_enabled()) {
+        t->cpu_ticks_offset = 0;
+        t->cpu_clock_offset = 0;
+    }
+    return 0;
+}
+#endif
+
 static const VMStateDescription vmstate_timers = {
     .name = "timer",
     .version_id = 2,
     .minimum_version_id = 1,
+#if defined(XBOX)
+    .pre_save = timers_pre_save,
+#endif
