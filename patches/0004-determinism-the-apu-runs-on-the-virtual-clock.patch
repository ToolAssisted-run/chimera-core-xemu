+/* CHIMERA: the deterministic EP frame pump. The hardware produces one EP
+ * frame every 256 samples at 48kHz; the SDL build approximates that with a
+ * free-running thread throttled against the host clock and the audio queue,
+ * which makes the DSP's progress relative to the CPU a property of the host.
+ * Here the same per-frame body runs from a QEMU_CLOCK_VIRTUAL timer instead:
+ * under icount, both the moment a frame runs and everything it computes are
+ * pure functions of the machine.
+ */
+static void apu_vframe_tick(void *opaque)
+{
+    MCPXAPUState *d = MCPX_APU_DEVICE(opaque);
+
+    qemu_mutex_lock(&d->lock);
+    int xcntmode = GET_MASK(qatomic_read(&d->regs[NV_PAPU_SECTL]),
+                            NV_PAPU_SECTL_XCNTMODE);
+    uint32_t fectl = qatomic_read(&d->regs[NV_PAPU_FECTL]);
+    bool halted = xcntmode == NV_PAPU_SECTL_XCNTMODE_OFF ||
+                  (fectl & NV_PAPU_FECTL_FEMETHMODE_TRAPPED) ||
+                  (fectl & NV_PAPU_FECTL_FEMETHMODE_HALTED);
+
+    if (halted || d->set_irq) {
+        update_irq(d); /* BQL is held in timer context */
+        d->set_irq = false;
+    }
+    if (!halted) {
+        se_frame(d);
+    }
+    qemu_mutex_unlock(&d->lock);
+
+    /* absolute deadlines - re-arming off "now" would accumulate callback
+     * lateness, which is host timing */
+    d->vframe_next += (int64_t)EP_FRAME_US * 1000;
+    timer_mod_ns(d->vframe_timer, d->vframe_next);
+}
+#endif /* !CONFIG_SDL */
 
