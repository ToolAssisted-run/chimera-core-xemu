+    return;
+#endif
     d->pause_requested = true;
     qemu_cond_signal(&d->cond);
     while (!d->is_idle) {
@@ -313,6 +363,9 @@ static void mcpx_apu_wait_for_idle(MCPXAPUState *d)
 
