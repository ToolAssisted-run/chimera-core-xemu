+/* CHIMERA: <vulkan/vulkan.h> for the sandbox build.
+ *
+ * miniBox carries the two headers its Vulkan bridge needs (vulkan_core.h and
+ * vk_platform.h) and nothing of any window system, because a sandboxed core
+ * has no window. vulkan.h proper is those two and the window systems' own
+ * headers, so this is all of it that applies here. */
+#ifndef VULKAN_H_
+#define VULKAN_H_ 1
+
+#include <vulkan/vk_platform.h>
+#include <vulkan/vulkan_core.h>
+
+#endif
diff --git a/hw/xbox/nv2a/pgraph/vk/chimera.c b/hw/xbox/nv2a/pgraph/vk/chimera.c
new file mode 100644
--- /dev/null
+++ b/hw/xbox/nv2a/pgraph/vk/chimera.c
@@ -0,0 +1,261 @@
+/*
+ * CHIMERA: the Vulkan renderer in Chimera's sandbox.
+ *
+ * Three things a desktop xemu does not need:
+ *
+ * - The device is Chimera's. The frontend hands the core one function
+ *   (SetVulkanBridge in the driver); the guest half of miniBox's Vulkan bridge
+ *   turns every Vulkan command into a call of it, and volk asks that half for
+ *   each command by name (instance.c).
+ *
+ * - There is no window and no OpenGL context to share the finished frame
+ *   with. The frame the display code composes is copied to a buffer and read
+ *   back (nv2a_chimera_vk_read_display), which is what the driver hands
+ *   Chimera as the picture.
+ *
+ * - A load of the machine is a new Vulkan device on the frontend's side, and
+ *   everything made on the old one is gone. The renderer's handles are in the
+ *   machine's memory, so a state brings them back, naming nothing. So the
+ *   renderer asks which device it is on at the head of every path that is
+ *   about to use one (pgraph_vk_check_context) and, when it has changed, lets
+ *   go of everything and starts again - as upstream does when the user changes
+ *   renderer. While it lets go nothing crosses to the frontend (the quiet
+ *   switch): each command answers "done", because what it names is another
+ *   device's and would be refused.
+ *
+ * Copyright (c) 2026 the Chimera project
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/xbox/nv2a/nv2a_int.h"
+#include "renderer.h"
+
+#ifdef CHIMERA_GUEST_VK
+
+typedef uint64_t (*chimera_vk_bridge_fn)(uint64_t op, uint64_t a, uint64_t b,
+                                         uint64_t c, uint64_t d, uint64_t e);
+bool chimera_vk_install(chimera_vk_bridge_fn bridge);
+uint64_t chimera_vk_context_id(void);
+void chimera_vk_description(char *out, uint32_t size);
+void chimera_vk_forget_mappings(void);
+
+static chimera_vk_bridge_fn s_host;
+static bool s_installed;
+static bool s_quiet;
+
+/* opcodes below 100 are the bridge's own questions (which device is this) and
+ * are answered whatever the switch says */
+static uint64_t bridge(uint64_t op, uint64_t a, uint64_t b, uint64_t c,
+                       uint64_t d, uint64_t e)
+{
+    if (s_quiet && op >= 100) {
+        return 0;
+    }
+    return s_host(op, a, b, c, d, e);
+}
+
+bool chimera_vk_try_bridge(uint64_t addr)
+{
+    s_host = (chimera_vk_bridge_fn)(uintptr_t)addr;
+    s_installed = s_host != NULL && chimera_vk_install(bridge);
+    return s_installed;
+}
+
+bool chimera_vk_available(void)
+{
+    return s_installed;
+}
+
+const char *chimera_vk_describe(void)
+{
+    static char text[256];
+    text[0] = 0;
+    if (s_installed) {
+        chimera_vk_description(text, sizeof text);
+    }
+    return text;
+}
+
+/* Which device the objects were made on. A state restores this with the rest
+ * of the machine, so after a load it is the saved session's; the live one is
+ * this session's. The flag is the frontend's word that the machine's memory
+ * was replaced (StateLoaded): a state taken before the renderer first looked
+ * carries 0 here, which then cannot vouch for what the driver holds - the
+ * same trap as the OpenGL renderer's (gl/renderer.c, chimera issue 126). */
+static uint64_t s_device;
+static bool s_state_loaded;
+
+void pgraph_vk_state_loaded(void)
+{
+    s_state_loaded = true;
+}
+
+void pgraph_vk_check_context(NV2AState *d)
+{
+    const bool after_load = s_state_loaded;
+    s_state_loaded = false;
+
+    const uint64_t live = chimera_vk_context_id();
+    if (live == 0 || live == s_device) {
+        if (live != 0) {
+            s_device = live;
+        }
+        return;
+    }
+
+    if ((s_device != 0 || after_load) && d->pgraph.vk_renderer_state != NULL) {
+        PGRAPHVkState *r = d->pgraph.vk_renderer_state;
+        fprintf(stderr, "chimera: Vulkan objects came from device %llu, now "
+                "%llu; rebuilding\n", (unsigned long long)s_device,
+                (unsigned long long)live);
+
+        /* Nothing of the old device can be fetched any more. What a surface
+         * held was written into RAM before the state was taken (the driver's
+         * StateSaving), so no surface is left to download - and one marked
+         * as needing it must not be, with the bridge silent: the download
+         * would copy the staging buffer's old bytes into the machine. */
+        SurfaceBinding *s;
+        QTAILQ_FOREACH(s, &r->surfaces, entry) {
+            s->draw_dirty = false;
+            s->download_pending = false;
+        }
+        r->in_command_buffer = false;
+        r->in_render_pass = false;
+        r->in_aux_command_buffer = false;
+        r->query_in_flight = false;
+
+        s_quiet = true;
+        pgraph_vk_chimera_finalize(d);
+        chimera_vk_forget_mappings();
+        s_quiet = false;
+        pgraph_vk_chimera_init(d);
+    }
+    s_device = live;
+}
+
+/* The finished frame, out of the machine: BGRA rows, top row first. Runs the
+ * sync upstream's window runs - the surface that scans out is composed, video
+ * overlay and all, into the display image - then copies the image to the
+ * staging buffer and reads it. Called by the driver at a frame boundary.
+ * 0 when no surface scans out: the caller shows the VGA view of RAM. */
+int nv2a_chimera_vk_read_display(uint8_t *out, int cap_w, int cap_h,
+                                 int *out_w, int *out_h)
+{
+    NV2AState *d = g_nv2a;
+    if (d == NULL || d->pgraph.vk_renderer_state == NULL) {
+        return 0;
+    }
+    PGRAPHState *pg = &d->pgraph;
+
+    pgraph_vk_check_context(d);
+    PGRAPHVkState *r = pg->vk_renderer_state;
+
+    qemu_mutex_lock(&d->pfifo.lock);
+    VGADisplayParams vga_display_params;
+    d->vga.get_params(&d->vga, &vga_display_params);
+    SurfaceBinding *surface = pgraph_vk_surface_get_within(
+        d, d->pcrtc.start + vga_display_params.line_offset);
+    if (surface == NULL || !surface->color) {
+        qemu_mutex_unlock(&d->pfifo.lock);
+        return 0;
+    }
+    surface->frame_time = pg->frame_time;
+    qemu_event_reset(&d->pgraph.sync_complete);
+    qatomic_set(&pg->sync_pending, true);
+    pfifo_kick(d);
+    qemu_mutex_unlock(&d->pfifo.lock);
+    pfifo_service_pending(d); /* CHIMERA: no pfifo thread - see pfifo.c */
+    qemu_event_wait(&d->pgraph.sync_complete);
+
+    r = pg->vk_renderer_state;
+    PGRAPHVkDisplayState *disp = &r->display;
+    const int w = disp->width, h = disp->height;
+    const VkDeviceSize bytes = (VkDeviceSize)w * h * 4;
+    StorageBuffer *staging = &r->storage_buffers[BUFFER_STAGING_DST];
+    if (disp->image == VK_NULL_HANDLE || w <= 0 || h <= 0 || w > cap_w ||
+        h > cap_h || bytes > staging->buffer_size) {
+        return 0;
+    }
+
+    VkCommandBuffer cmd = pgraph_vk_begin_single_time_commands(pg);
+    VkImageMemoryBarrier barrier = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_SHADER_READ_BIT,
+        .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+        .oldLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+        .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .image = disp->image,
+        .subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+        .subresourceRange.levelCount = 1,
+        .subresourceRange.layerCount = 1,
+    };
+    vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                         VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL,
+                         1, &barrier);
+    VkBufferImageCopy region = {
+        .imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+        .imageSubresource.layerCount = 1,
+        .imageExtent = { w, h, 1 },
+    };
+    vkCmdCopyImageToBuffer(cmd, disp->image,
+                           VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                           staging->buffer, 1, &region);
+    barrier.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    barrier.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    barrier.newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, NULL, 0,
+                         NULL, 1, &barrier);
+    pgraph_vk_end_single_time_commands(pg, cmd);
+
+    void *mapped = NULL;
+    VK_CHECK(vmaMapMemory(r->allocator, staging->allocation, &mapped));
+    vmaInvalidateAllocation(r->allocator, staging->allocation, 0, bytes);
+    /* The display image is drawn for an OpenGL texture, whose first row is
+     * the bottom one: the rows come out in the other order here. RGBA bytes
+     * become BGRA. The fourth byte is passed on as it is, as the OpenGL
+     * renderer's read does: it is what the game left there, and it is what
+     * the VGA view of RAM shows when no surface scans out (the frames right
+     * after a load), so the same frame is the same bytes either way. */
+    for (int y = 0; y < h; y++) {
+        const uint8_t *in = (const uint8_t *)mapped + (size_t)(h - 1 - y) * w * 4;
+        uint8_t *row = out + (size_t)y * w * 4;
+        for (int x = 0; x < w * 4; x += 4) {
+            row[x + 0] = in[x + 2];
+            row[x + 1] = in[x + 1];
+            row[x + 2] = in[x + 0];
+            row[x + 3] = in[x + 3];
+        }
+    }
+    vmaUnmapMemory(r->allocator, staging->allocation);
+
+    *out_w = w;
+    *out_h = h;
+    return 1;
+}
+
+/* What the GPU drew, into the machine, before a state is taken: the Vulkan
+ * twin of nv2a_chimera_flush_surfaces (gl/display.c, chimera issue 190).
+ * Under TCG a surface reaches the console's RAM only when the processor reads
+ * it; a state is the machine's memory, and a load makes the renderer again
+ * from that memory. */
+void nv2a_chimera_vk_flush_surfaces(void)
+{
+    NV2AState *d = g_nv2a;
+    if (d == NULL || d->pgraph.vk_renderer_state == NULL) {
+        return;
+    }
+    pgraph_vk_check_context(d);
+    pgraph_pre_savevm_trigger(d);
+    pgraph_pre_savevm_wait(d);
+}
+
+#endif /* CHIMERA_GUEST_VK */
