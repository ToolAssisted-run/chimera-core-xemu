diff --git a/hw/xbox/nv2a/pgraph/gl/display.c b/hw/xbox/nv2a/pgraph/gl/display.c
index fafcd72061..46e0ddf78f 100644
--- a/hw/xbox/nv2a/pgraph/gl/display.c
+++ b/hw/xbox/nv2a/pgraph/gl/display.c
@@ -434,7 +434,42 @@ int pgraph_gl_get_framebuffer_surface(NV2AState *d)
     qatomic_set(&pg->sync_pending, true);
     pfifo_kick(d);
     qemu_mutex_unlock(&d->pfifo.lock);
+    pfifo_service_pending(d);
     qemu_event_wait(&d->pgraph.sync_complete);
 
     return r->gl_display_buffer;
 }
+
+/* CHIMERA: the true presented frame, out of the machine. Runs the same sync
+ * the GUI's scanout runs - the surface is composed (PVIDEO overlay and all)
+ * into gl_display_buffer in the display context - then reads it back BGRA.
+ * Called from the driver at the frame boundary while the machine is paused;
+ * returns 0 when no surface scans out (the caller falls back to the VGA
+ * view of RAM, which is also what a machine that never lit the GPU shows).
+ */
+int nv2a_chimera_read_display(uint8_t *out, int cap_w, int cap_h,
+                              int *out_w, int *out_h)
+{
+    NV2AState *d = g_nv2a;
+    if (d == NULL || d->pgraph.gl_renderer_state == NULL) {
+        return 0;
+    }
+    if (pgraph_gl_get_framebuffer_surface(d) == 0) {
+        return 0;
+    }
+    PGRAPHGLState *r = d->pgraph.gl_renderer_state;
+    int w = r->gl_display_buffer_width, h = r->gl_display_buffer_height;
+    if (w <= 0 || h <= 0 || w > cap_w || h > cap_h) {
+        return 0;
+    }
+    glo_set_current(g_nv2a_context_display);
+    glBindFramebuffer(GL_FRAMEBUFFER, r->disp_rndr.fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_2D, r->gl_display_buffer, 0);
+    glo_readpixels(GL_BGRA, GL_UNSIGNED_BYTE, 4, w * 4, w, h, true, out);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glo_set_current(g_nv2a_context_render);
+    *out_w = w;
+    *out_h = h;
+    return 1;
+}
