@@ -22,6 +22,14 @@
 #include "hw/xbox/mcpx/apu/apu_int.h"
 #include "adpcm.h"
 
+/* CHIMERA: sample math must round identically in the native reference and
+ * the guest; glibc and musl powf/pow differ by a ULP on a few inputs, so
+ * both builds use the copies in ../det-pow.c (musl's own implementation). */
+extern float chimera_powf(float x, float y);
+extern double chimera_pow(double x, double y);
+#define powf chimera_powf
+#define pow chimera_pow
+
 static const struct {
     hwaddr top, current, next;
 } voice_list_regs[] = {
@@ -1725,6 +1733,18 @@ voice_work_dispatch(MCPXAPUState *d,
 
     int64_t start_time = qemu_clock_get_us(QEMU_CLOCK_REALTIME);
 
+#ifndef CONFIG_SDL
+    /* CHIMERA: this runs in virtual-timer context on the vCPU thread with
+     * the BQL held - waiting for the guest to unlock a voice would block
+     * the very thread that has to do the unlocking. A voice locked at this
+     * exact virtual instant is the guest mid-update; skipping the whole VP
+     * frame is deterministic (lock state is machine state) and inaudible.
+     */
+    if (qatomic_read(&d->pause_requested) || any_queued_voice_locked(d)) {
+        vwd->queue_len = 0;
+        return;
+    }
+#else
     while (true) {
         if (qatomic_read(&d->pause_requested)) {
             vwd->queue_len = 0;
@@ -1737,6 +1757,7 @@ voice_work_dispatch(MCPXAPUState *d,
 
         qemu_cond_timedwait(&d->cond, &d->lock, 1);
     }
+#endif
 
     qemu_mutex_lock(&vwd->lock);
 
@@ -1768,7 +1789,13 @@ static void voice_work_init(MCPXAPUState *d)
 {
     VoiceWorkDispatch *vwd = &d->vp.voice_work_dispatch;
 
+#ifdef CONFIG_SDL
     int num_workers = g_config.audio.vp.num_workers ?: SDL_GetNumLogicalCPUCores();
+#else
+    /* CHIMERA: a worker count read off the host CPU is a determinism leak;
+     * headless defaults to one worker unless the config says otherwise */
+    int num_workers = g_config.audio.vp.num_workers ?: 1;
+#endif
     vwd->num_workers = MAX(1, MIN(num_workers, MAX_VOICE_WORKERS));
     vwd->workers = g_malloc0_n(vwd->num_workers, sizeof(VoiceWorker));
     vwd->workers_should_exit = false;
