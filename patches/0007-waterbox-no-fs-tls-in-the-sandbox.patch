diff --git a/include/qemu/coroutine-tls.h b/include/qemu/coroutine-tls.h
index 1558a826aa..a71737b99f 100644
--- a/include/qemu/coroutine-tls.h
+++ b/include/qemu/coroutine-tls.h
@@ -115,12 +115,45 @@
  *
  *   __thread int my_count;
  */
+#ifdef CHIMERA_GUEST
+/* CHIMERA: the waterbox has no fs-based TLS - a __thread access lands in the
+ * HOST's thread block and corrupts it. The guest's pthreads (green threads)
+ * carry keyed storage through the gs-based thread pointer, so these
+ * accessors become pthread_key lookups: per-green-thread, sandbox-safe, and
+ * still coroutine-correct.
+ */
+#include <pthread.h>
+#include <stdlib.h>
+
+#define QEMU__CO_TLS_BODY(type, var, linkage)                                \
+    static pthread_key_t co_tls_key_##var;                                   \
+    static pthread_once_t co_tls_once_##var = PTHREAD_ONCE_INIT;             \
+    static void co_tls_mkkey_##var(void)                                     \
+    { pthread_key_create(&co_tls_key_##var, free); }                         \
+    linkage __attribute__((noinline, unused)) type *get_ptr_##var(void)      \
+    {                                                                        \
+        pthread_once(&co_tls_once_##var, co_tls_mkkey_##var);                \
+        type *p = pthread_getspecific(co_tls_key_##var);                     \
+        if (!p) {                                                            \
+            p = calloc(1, sizeof(type));                                     \
+            pthread_setspecific(co_tls_key_##var, p);                        \
+        }                                                                    \
+        return p;                                                            \
+    }                                                                        \
+    linkage __attribute__((noinline, unused)) type get_##var(void)           \
+    { return *get_ptr_##var(); }                                             \
+    linkage __attribute__((noinline, unused)) void set_##var(type v)         \
+    { *get_ptr_##var() = v; }
+
+#define QEMU_DEFINE_CO_TLS(type, var) QEMU__CO_TLS_BODY(type, var, )
+#else
 #define QEMU_DEFINE_CO_TLS(type, var)                                        \
     static __thread type co_tls_##var;                                       \
     type get_##var(void) { asm volatile(""); return co_tls_##var; }          \
     void set_##var(type v) { asm volatile(""); co_tls_##var = v; }           \
     type *get_ptr_##var(void)                                                \
     { type *ptr = &co_tls_##var; asm volatile("" : "+rm" (ptr)); return ptr; }
+#endif
 
 /**
  * QEMU_DEFINE_STATIC_CO_TLS:
@@ -150,6 +183,9 @@
  *   my_count = c + 1;
  *   *(&my_count) = 0;
  */
+#ifdef CHIMERA_GUEST
+#define QEMU_DEFINE_STATIC_CO_TLS(type, var) QEMU__CO_TLS_BODY(type, var, static)
+#else
 #define QEMU_DEFINE_STATIC_CO_TLS(type, var)                                 \
     static __thread type co_tls_##var;                                       \
     static __attribute__((noinline, unused))                                 \
@@ -161,5 +197,6 @@
     static __attribute__((noinline, unused))                                 \
     type *get_ptr_##var(void)                                                \
     { type *ptr = &co_tls_##var; asm volatile("" : "+rm" (ptr)); return ptr; }
+#endif /* !CHIMERA_GUEST */
 
-#endif /* QEMU_COROUTINE_TLS_H */
+#endif /* QEMU_COROUTINE_TLS_H */
