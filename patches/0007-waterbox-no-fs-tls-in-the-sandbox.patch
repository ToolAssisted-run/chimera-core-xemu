 /* current CPU in the current thread. It is only valid inside cpu_exec() */
+#ifdef CHIMERA_GUEST
+#include <pthread.h>
+static pthread_key_t chimera_cpu_key;
+static pthread_once_t chimera_cpu_once = PTHREAD_ONCE_INIT;
+static void chimera_cpu_mkkey(void)
+{
+    pthread_key_create(&chimera_cpu_key, free);
+}
+CPUState **chimera_current_cpu_ptr(void)
+{
+    pthread_once(&chimera_cpu_once, chimera_cpu_mkkey);
+    CPUState **p = pthread_getspecific(chimera_cpu_key);
+    if (!p) {
+        p = calloc(1, sizeof(*p));
+        pthread_setspecific(chimera_cpu_key, p);
+    }
+    return p;
+}
+#else
 __thread CPUState *current_cpu;
+#endif
 
