+++ b/hw/xbox/nv2a/nv2a_int.h
@@ -102,6 +102,8 @@ typedef struct NV2AState {
         QemuCond fifo_cond;
         QemuCond fifo_idle_cond;
         bool fifo_kick;
+        bool in_drain; /* CHIMERA: reentrancy guard for the synchronous kick */
+        QEMUTimer *drain_timer; /* CHIMERA: runs pfifo_drain at virtual-now */
