diff --git a/hw/xbox/nv2a/pfifo.c b/hw/xbox/nv2a/pfifo.c
index ff4625c258..4e3c6b0c32 100644
--- a/hw/xbox/nv2a/pfifo.c
+++ b/hw/xbox/nv2a/pfifo.c
@@ -89,11 +89,59 @@ void pfifo_write(void *opaque, hwaddr addr, uint64_t val, unsigned int size)
     qemu_mutex_unlock(&d->pfifo.lock);
 }
 
+#ifdef CONFIG_SDL
 void pfifo_kick(NV2AState *d)
 {
     d->pfifo.fifo_kick = true;
     qemu_cond_broadcast(&d->pfifo.fifo_cond);
 }
+#else
+/* CHIMERA: the deterministic pfifo. With a host thread, how much pushbuffer
+ * the GPU has consumed by the time the CPU polls it is a race; here a kick
+ * only raises the flag, and pfifo_drain - called at every point that raises
+ * it, once locks allow (pfifo.lock held, pgraph.lock not) - consumes work
+ * synchronously in the guest's own context, so consumption is a pure
+ * function of the machine's own ordering. The null renderer never blocks, which is what makes the inline
+ * drain safe; stalls (flip, pgraph access) exit the loop rather than wait,
+ * exactly as they exit the thread's loop, and the clearing event re-kicks.
+ */
+void pfifo_kick(NV2AState *d)
+{
+    d->pfifo.fifo_kick = true;
+    /* Drain at this exact virtual instant, but from the main loop: the
+     * vCPU's MMIO stack is no place to run pgraph work (paths in there can
+     * longjmp back to the CPU loop and leak every lock on the way). Under
+     * icount a timer at "now" is still deterministic - the vCPU stops at
+     * the deadline and the drain interleaves at a reproducible point.
+     */
+    timer_mod_ns(d->pfifo.drain_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+}
+
+void pfifo_drain_cb(void *opaque)
+{
+    NV2AState *d = opaque;
+    qemu_mutex_lock(&d->pfifo.lock);
+    pfifo_drain(d);
+    qemu_mutex_unlock(&d->pfifo.lock);
+}
+
+void pfifo_drain(NV2AState *d)
+{
+    if (d->pfifo.in_drain) {
+        return; /* a kick from inside the drain: the loop goes round again */
+    }
+    d->pfifo.in_drain = true;
+    while (d->pfifo.fifo_kick) {
+        d->pfifo.fifo_kick = false;
+        pgraph_process_pending(d);
+        if (!d->pfifo.halt) {
+            pfifo_run_pusher(d);
+        }
+        pgraph_process_pending_reports(d);
+    }
+    d->pfifo.in_drain = false;
+}
+#endif
 
